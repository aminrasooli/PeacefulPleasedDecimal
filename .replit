entrypoint = "main.py"
modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[unitTest]
language = "python3"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[env]
# The app binds to 127.0.0.1 by default for safe local development.
# Hosted Replit/Cloud Run deployments need the public bind address.
HOST = "0.0.0.0"

[deployment]
run = ["python3", "main.py"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 81
externalPort = 80
